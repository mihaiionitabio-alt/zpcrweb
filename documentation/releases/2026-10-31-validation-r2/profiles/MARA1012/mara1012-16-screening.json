  "interpretation": {
    "principles": [
      "Threshold comparison only. Event identity must be established by a published event-specific assay. No standard curve or numerical percentage is produced."
    ],
    "rules": [
      {
        "id": "D01",
        "when": "ddCt < -0.4",
        "action": "event detected, content higher than control",
        "outcome": "Positive"
      },
      {
        "id": "D02",
        "when": "ddCt > 0.4",
        "action": "event detected, content lower than control",
        "outcome": "Positive"
      },
      {
        "id": "D03",
        "when": "-0.4 <= ddCt <= 0.4",
        "action": "determine content with a validated quantitative method",
        "outcome": "Inconclusive"
      }
    ],
