  "interpretation": {
    "principles": [
      "A detected element or trait gene is a candidate signal, not an event. P-35S occurs in many events and in natural cauliflower mosaic virus; a trait gene recurs across constructs.",
      "The taxon reference establishes DNA fitness and crop presence and is never omitted because the element panel is optimised.",
      "Every screening report states the panel actually used and its LOD.",
      "A positive screen obliges event-specific identification; a labelling decision additionally obliges quantification.",
      "A negative screen covers only the tested targets at the stated method LOD; it does not establish absence of all GMOs."
    ],
    "rules": [
      {
        "id": "S01",
        "when": "taxon reference Ct <= 36 and a screening element Ct <= 36",
        "action": "report element detected as a candidate; raise identification",
        "outcome": "Positive"
      },
      {
        "id": "S02",
        "when": "taxon reference Ct <= 36 and no screening element below cut-off",
        "action": "report no selected target detected at the stated LOD",
        "outcome": "Negative"
      },
      {
        "id": "S03",
        "when": "taxon reference absent, late or Ct > 36",
        "action": "do not report the element result",
        "outcome": "Invalid"
      },
      {
        "id": "S04",
        "when": "blank or negative control amplifies a screening target",
        "action": "do not issue sample calls",
        "outcome": "Control fail"
      },
      {
        "id": "S05",
        "when": "a labelling threshold decision is requested",
        "action": "do not answer from this profile",
        "outcome": "Profile not applicable"
      }
    ],
    "reporting": {
      "include_rule_id": true,
      "include_reason": true,
      "include_stored_call": true,
      "include_panel_coverage": true,
      "include_lod": true,
      "release_statuses": []
    }
  },
  "controlCharts": {},
  "blockedAutomaticInterpretations": [
    "This profile cannot issue an event identity.",
    "This profile cannot issue a quantitative result or a threshold decision; its LOD is 1 %.",
    "A negative screen must not be reported as 'GMO free'.",
    "Panel coverage and oligo identities must be confirmed against the published standard before any automated call.",
    "Control acceptance is signal-based in 7.3.5; the event-method Ct-based control rule must not be substituted. Laboratory replication plan and control materials remain to be confirmed.",
    "Select and record the actual Annex A/B assays; the 25 Annex B entries are a catalogue, not an automatically tested panel. Component assays alone do not establish a stacked event in one organism.",
    "Portable rapid-PCR workflow and matrix must be verified; a desktop instrument name does not establish standard-17 applicability. Lateral-flow readings are outside the qPCR reader.",
    "Laboratory approval is separate from automatic calculation. Missing method evidence produces a specific unresolved or repeat result; missing data never establish a GMO-negative sample."
  ],
