  "interpretation": {
    "principles": [
      "The measurand is a copy-number ratio, event over crop reference, expressed as a percentage.",
      "The two standard curves come from the same dilution series, so the denominators are method-specific and not interchangeable with EURL references such as hmg, adh1 or acp1.",
      "A result below the LOQ is not a number; it is reported through the below-LOQ branch.",
      "Every quantitative result carries its expanded uncertainty; a bare percentage is not a result.",
      "Cotton is allotetraploid, so the reference-copy assumption must be stated with the result."
    ],
    "rules": [
      {
        "id": "Q01",
        "when": "all control and curve criteria pass and the sample mean >= LOQ with s'R <= 25 %",
        "action": "report C = mean +/- U",
        "outcome": "Positive"
      },
      {
        "id": "Q02",
        "when": "event detected but the mean is below the LOQ",
        "action": "report detected, content below the quantification limit",
        "outcome": "Positive",
        "source_clause": "6.5.2"
      },
      {
        "id": "Q03",
        "when": "R2 < 0.98 or the slope falls outside -3.6 to -3.1",
        "action": "reject the run",
        "outcome": "Invalid run",
        "source_clause": "6.4.8.4"
      },
      {
        "id": "Q04",
        "when": "the quantitative control fails its acceptance test",
        "action": "issue no quantitative result; investigate and repeat",
        "outcome": "Control fail",
        "source_clause": "6.4.10.3"
      },
      {
        "id": "Q05",
        "when": "s'R > 25 % at or above the LOQ",
        "action": "the sample data are not acceptable; repeat amplification or re-prepare the test portion",
        "outcome": "Repeat",
        "source_clause": "6.4.10.2.2"
      }
    ],
    "reporting": {
      "include_rule_id": true,
      "include_reason": true,
      "include_uncertainty": true,
      "include_reference_gene": true,
      "include_calibrator_levels": true,
      "release_statuses": []
    }
  },
