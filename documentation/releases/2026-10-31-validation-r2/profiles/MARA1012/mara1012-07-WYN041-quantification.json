  "calculation": {
    "per_subsample_ratio": "mean event copies / mean reference copies x 100, per subsample k",
    "sample_result": "mean of the 3 subsample ratios",
    "range_coefficient_f": {
      "n_3": 1.693
    },
    "uncertainty": {
      "model": "u = sqrt(u0^2 + (ur * mean)^2)",
      "u0": 0.0017,
      "ur": 0.1147,
      "basis": "MARA 1012-7-2026 clause 6.4.11.2; values verified against this standard, not inherited from ND207",
      "coverage_factor_k": 2,
      "confidence": "95 %",
      "expanded": "U = k * u, reported to 2 significant figures",
      "result_statement": "C = mean +/- U, with the last significant digit of C rounded to that of U",
      "laboratory_own_evaluation": "permitted, top-down or bottom-up, from sufficient positive samples or CRM",
      "source_clause": "6.4.11.2, 6.4.11.3",
      "expanded_significant_figures": 2,
      "align_result_to_uncertainty": true,
      "mode": "standard",
      "laboratory": {
        "u0": "",
        "ur": "",
        "coverage_factor_k": 2,
        "range_min_percent": "",
        "range_max_percent": "",
        "validated": false,
        "components_complete": false,
        "measurand": "copy-number ratio"
      }
    },
    "standard_curve_inverse": "copies = 10^((Ct - intercept) / slope), separately for event and reference",
    "sample_rsd": "s_prime = (max(subsample_ratios) - min(subsample_ratios)) / 1.693; s_prime_R = s_prime / mean(subsample_ratios) * 100"
  },
  "data_acceptance": {
    "quantitative_control": {
      "if_certified_reference_material": {
        "criterion": "|bias| < 2 * u_bias",
        "u_bias": "sqrt(u_CRM^2 + u(mean)^2)",
        "u_mean": "(cmax - cmin)/f / sqrt(n), n = 3, f = 1.693",
        "source_clause": "6.4.10.1.2"
      },
      "if_laboratory_prepared": {
        "criterion": "sR <= 25 % AND |biasR| <= 25 %",
        "sR": "s / mean x 100, s = (cmax - cmin)/f",
        "biasR": "(mean - expected)/expected x 100",
        "source_clause": "6.4.10.1.3"
      }
    },
    "sample": {
      "if_mean_at_or_above_LOQ": {
        "threshold_percent": 0.1,
