      "numeric_rules": "Published standard text; local PDF SHA-256 recorded",
      "status": "Source-referenced draft; not laboratory approved"
    }
  },
  "interpretation": {
    "principles": [
      "The target is the insert-plant-genome junction. An element or a trait gene is not an event.",
      "A result is read only when the crop reference gene amplifies: reference and event are evaluated together, never separately.",
      "Ct > 36 or no typical amplification curve counts as not detected, even though 40 cycles are run.",
      "Where the three subsamples disagree, the majority decides; the minority result is retained in the record.",
      "Stored Cq values, calls and fluorescence traces are never altered by this profile."
    ],
    "rules": [
      {
        "id": "E01",
        "when": "reference gene typical curve with Ct <= 36 AND event sequence typical curve with Ct <= 36",
        "action": "report the event component as detected",
        "outcome": "Positive",
        "source_clause": "5.5.1"
      },
      {
        "id": "E02",
        "when": "reference gene typical curve with Ct <= 36 AND event sequence absent or Ct > 36",
        "action": "report the event component as not detected",
        "outcome": "Negative",
        "source_clause": "5.5.1"
      },
      {
        "id": "E03",
        "when": "reference gene absent or Ct > 36 in a sample",
        "action": "do not report; the DNA is not fit",
        "outcome": "Invalid"
      },
      {
        "id": "E04",
        "when": "the three subsamples disagree",
        "action": "apply the majority result and record the discordance",
        "outcome": "Positive|Negative",
        "source_clause": "5.5"
      },
      {
        "id": "E05",
        "when": "any control fails 5.4.7.1 to 5.4.7.3",
        "action": "issue no sample call; repeat from 5.4.4 or 5.4.6",
        "outcome": "Control fail",
        "source_clause": "5.4.7.4"
      },
      {
        "id": "E06",
        "when": "E01 holds and a content comparison against the quantitative control is requested",
        "action": "compute dCt and ddCt and apply the band in E07",
        "outcome": "Positive"
      },
      {
        "id": "E07",
        "when": "ddCt < -0.4",
        "action": "ddCt < -0.4: higher; ddCt > +0.4: lower; |ddCt| <= 0.4: use method 2 quantification, including both boundary values.",
        "outcome": "Positive",
        "source_clause": "5.5.2",
        "note": "Direction verified for this event standard; this does not modify laboratory SOP-06."
      }
    ],
    "reporting": {
      "include_rule_id": true,
      "include_reason": true,
      "include_stored_call": true,
      "include_subsample_detail": true,
      "statement_template": "试样中检测出 {event} 转化体成分，检测结果为阳性",
      "release_statuses": []
    }
  },
